{
  "name": "smart-campus-backend",
  "version": "1.0.0",
  "description": "智能校园后端API服务",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "init:db": "node src/scripts/initDatabase.js",
    "migrate": "node src/migrations/index.js",
    "migrate:status": "node src/migrations/index.js status",
    "migrate:down": "node src/migrations/index.js down",
    "seed:core": "node src/migrations/runSql.js src/migrations/seed/seed_core_data.sql",
    "seed:users": "node src/migrations/runSql.js src/migrations/seed/seed_test_users.sql",
    "seed:scores": "node src/migrations/runSql.js src/migrations/seed/seed_test_scores.sql",
    "seed:timetable": "node src/migrations/runSql.js src/migrations/seed/seed_test_timetable.sql",
    "seed:activities": "node src/migrations/runSql.js src/migrations/seed/seed_test_activities.sql",
    "seed:electives": "node src/migrations/runSql.js src/migrations/seed/seed_test_electives.sql",
    "seed": "npm run seed:core && npm run seed:users && npm run seed:scores && npm run seed:timetable && npm run seed:activities && npm run seed:electives",
    "sql": "node src/migrations/runSql.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5",
    "node-cron": "^3.0.3",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}