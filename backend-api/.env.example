# 智评校园 - 环境变量配置
# 复制此文件为 .env 并填入真实配置

# ==================== 数据库配置 ====================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=smart_campus

# ==================== 服务器配置 ====================
PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_change_this
JWT_EXPIRES_IN=7d

# CORS 允许来源（逗号分隔）。生产环境未配置时保持宽松默认（*），配置后仅放行列出的来源
# 示例：CORS_ORIGINS=https://campus.example.com,https://admin.example.com
CORS_ORIGINS=

# 是否在错误响应中返回错误堆栈（仅 NODE_ENV=development 时生效，默认 false）
DEBUG_ERROR_STACK=false

# ==================== DeepSeek AI（可选） ====================
# 申请地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# ==================== Umi-OCR 本地服务（可选） ====================
# 项目地址：https://github.com/hiroi-sora/Umi-OCR
UMI_OCR_URL=http://127.0.0.1:1224/api/ocr

# ==================== AI 使用限制 ====================
AI_CHAT_DAILY_LIMIT=100
AI_OCR_DAILY_LIMIT=50
